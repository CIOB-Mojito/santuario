{
  "name": "santuario-primordio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Santuario Primordio: motor de una experiencia 3D interactiva, mobile-first.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "smoke": "esbuild tools/smoke.ts --bundle --platform=node --format=esm --outfile=.smoke.mjs --log-level=error && node .smoke.mjs",
    "check": "tsc --noEmit && vite build && npm run smoke"
  },
  "dependencies": {
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/three": "^0.186.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3",
    "vite": "^8.3.4"
  }
}
